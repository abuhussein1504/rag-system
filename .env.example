APP_NAME="rag-system"
APP_VERSION="0.1.0"

FILE_ALLOWED_TYPES=["pdf","txt","md","csv","docx","html","htm"]
FILE_MAX_SIZE = 10 # mb
DATA_DIR="data"

FILE_DEFAULT_CHUNK_SIZE=1000
FILE_DEFAULT_OVERLAP_SIZE=200

# EMBEDDING
EMBEDDING_BACKEND="remote"
EMBEDDING_MODEL_ID="BAAI/bge-base-en-v1.5"
EMBEDDING_MODEL_SIZE=768
GOOGLE_API_KEY=your_key_here
REMOTE_EMBEDDER_URL=https://xxxx.ngrok-free.app

# VECTOR
VECTOR_DB_BACKEND="qdrant"
VECTOR_DB_PATH="data/indexes/qdrant"
VECTOR_DB_DISTANCE_METHOD="cosine"

# GENERATION
GENERATION_MODEL_ID="gemini-2.5-flash"
GENERATION_TEMPERATURE=0.0
DEFAULT_RETRIEVER="dense"              # dense | bm25 | hybrid | hybrid_rerank

